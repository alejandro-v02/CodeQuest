# --- Database (apps/api + docker-compose) ---
# 5433, not 5432: this machine already runs other projects' Postgres on 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=codequest
DB_PASSWORD=codequest
DB_NAME=codequest

# --- API ---
API_PORT=3000
NODE_ENV=development

# --- Auth (Fase 2) ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- GitHub OAuth login (Fase 2) ---
# Create an OAuth App at https://github.com/settings/developers.
# Authorization callback URL must match GITHUB_CALLBACK_URL exactly.
# Leave blank to keep GitHub login disabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://192.168.18.10:3000/auth/github/callback
# Custom URL scheme the mobile app listens on to receive tokens after the
# GitHub redirect; must match AndroidManifest.xml's intent-filter.
MOBILE_DEEP_LINK_URL=codequest://auth-callback

# --- AI provider (Fase 5A generator + Fase 5B tutor) ---
# OpenAI — create a key at https://platform.openai.com/api-keys (prepaid credit).
# Leave blank to keep AI generation/tutoring disabled (templates-only mode).
OPENAI_API_KEY=
# Optional overrides (defaults shown). The embedding model must support the
# `dimensions` parameter, because stored vectors are 1536 wide.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Max AI requests per user per rolling 24 h (default 10). Main lever on AI cost.
# AI_DAILY_LIMIT=10

# --- Code execution sandbox (Fase 4) ---
# Piston, self-hosted via docker-compose (see PISTON_PORT below). No API key
# needed. Run `npm run setup:piston` in apps/api once the container is up.
PISTON_PORT=2000
PISTON_API_URL=http://localhost:2000

# --- Redis / BullMQ (Fase 5A) ---
REDIS_HOST=localhost
REDIS_PORT=6379
